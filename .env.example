# Host ports can be changed independently; no rebuild is needed for these settings.
DEARLY_FRONTEND_BIND=127.0.0.1
DEARLY_FRONTEND_PORT=8003
DEARLY_BACKEND_BIND=127.0.0.1
DEARLY_BACKEND_PORT=8002

# Address reachable FROM the frontend container. Compose uses the backend service
# and its INTERNAL listen port, not the backend's published host port.
# Another machine: 192.168.1.20:9000 (publish that backend on its LAN interface).
# Docker host: host.docker.internal:9000. Never use localhost for another container.
DEARLY_BACKEND_ADDRESS=backend:8002

# Optional internal container ports. Keep BACKEND_ADDRESS aligned if changed.
DEARLY_FRONTEND_LISTEN_PORT=8003
DEARLY_BACKEND_LISTEN_PORT=8002
# Trust only actual frontend/proxy addresses when enabling forwarded client IPs.
DEARLY_PROXY_IPS=
